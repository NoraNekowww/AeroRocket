<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="#0A0F1D"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AEROROCKET 3D"
                android:textColor="@color/accent_blue"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="v1.1.2"
                android:textColor="@color/accent_amber"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ECMWF Wind Status Chip (Clickable to fetch current GPS location ECMWF) -->
        <LinearLayout
            android:id="@+id/chip_ecmwf"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_chip"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <View
                android:id="@+id/view_ecmwf_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/accent_green" />

            <TextView
                android:id="@+id/tv_ecmwf_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="定位获取ECMWF..."
                android:textColor="@color/text_primary"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </LinearLayout>

    <!-- Visual 3D / 2D Trajectory View Canvas with Satellite Ground & Center Orbit -->
    <com.nz.waterrocket.TrajectoryView
        android:id="@+id/trajectory_view"
        android:layout_width="match_parent"
        android:layout_height="230dp"
        android:background="#0C1322" />

    <!-- 5 HUD Quick Telemetry Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:background="#0F172A">

        <!-- HUD 1: Downrange X -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="射程 X"
                android:textColor="@color/text_muted"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/hud_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.0m"
                android:textColor="@color/accent_rose"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HUD 2: Crosswind Drift Z -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="侧漂 Z"
                android:textColor="@color/text_muted"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/hud_drift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.0m"
                android:textColor="@color/accent_amber"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HUD 3: Apex Altitude -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="顶点高度"
                android:textColor="@color/text_muted"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/hud_apogee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.0m"
                android:textColor="@color/accent_blue"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HUD 4: Max Speed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="最大极速"
                android:textColor="@color/text_muted"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/hud_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0km/h"
                android:textColor="@color/accent_green"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- HUD 5: Flight Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1.5dp"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="滞空时间"
                android:textColor="@color/text_muted"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/hud_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="0.0s"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Detailed Controls -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Card 1: Power, Bottle Specs & Drag Coefficient -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="瓶身规格与阻力系数 (Cd)"
                    android:textColor="@color/accent_blue"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <!-- Bottle Preset Selection: Including 500mL Experimental Small Bottle -->
                <RadioGroup
                    android:id="@+id/rg_bottle_preset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_spec_500"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="500mL试验"
                        android:textColor="@color/accent_amber"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_spec_1250"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1.25L"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_spec_1500"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="1.50L标准"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_spec_2000"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2.00L大瓶"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </RadioGroup>

                <!-- Drag Coefficient Cd Continuous Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="阻力系数 Cd"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <SeekBar
                        android:id="@+id/sb_cd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="55"
                        android:progress="20" />

                    <TextView
                        android:id="@+id/tv_cd_val"
                        android:layout_width="74dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="0.35"
                        android:textColor="@color/accent_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Pressure Control -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="充气气压"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <SeekBar
                        android:id="@+id/sb_pressure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="70"
                        android:progress="35" />

                    <TextView
                        android:id="@+id/tv_pressure_val"
                        android:layout_width="74dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="4.5 bar"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Water Volume Control -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="初始装水"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <SeekBar
                        android:id="@+id/sb_water"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1000"
                        android:progress="500" />

                    <TextView
                        android:id="@+id/tv_water_val"
                        android:layout_width="74dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="500mL (33%)"
                        android:textColor="@color/accent_blue"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Nozzle Throat Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="喷嘴口径"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <RadioGroup
                        android:id="@+id/rg_nozzle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_nozzle_21"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="标准 21mm"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />

                        <RadioButton
                            android:id="@+id/rb_nozzle_9"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="缩径 9mm"
                            android:textColor="@color/text_primary"
                            android:textSize="11.5sp" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <!-- Card 2: 3D Attitude, Heading (0-360 deg) & Location ECMWF Wind -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3D 发射航向与定位气象风场"
                        android:textColor="@color/accent_blue"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_refresh_location"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="获取当前定位ECMWF"
                        android:textColor="@color/accent_blue"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <!-- Launch Pitch Angle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="发射仰角"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <SeekBar
                        android:id="@+id/sb_angle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="55"
                        android:progress="15" />

                    <TextView
                        android:id="@+id/tv_angle_val"
                        android:layout_width="74dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="45°"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Launch Heading Direction (0-360 degrees True North) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="发射航向角"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <SeekBar
                        android:id="@+id/sb_heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="360"
                        android:progress="90" />

                    <TextView
                        android:id="@+id/tv_heading_val"
                        android:layout_width="74dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="090° (正东)"
                        android:textColor="@color/accent_rose"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Launch Yaw Aiming Offset Angle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="偏航瞄准角"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <SeekBar
                        android:id="@+id/sb_yaw"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="50"
                        android:progress="25" />

                    <TextView
                        android:id="@+id/tv_yaw_val"
                        android:layout_width="74dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="0° (对准)"
                        android:textColor="@color/accent_amber"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Wind Mode Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="风速模式"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <RadioGroup
                        android:id="@+id/rg_wind_mode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/rb_wind_ecmwf"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="当前定位ECMWF"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />

                        <RadioButton
                            android:id="@+id/rb_wind_manual"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="手动覆盖"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </RadioGroup>
                </LinearLayout>

                <!-- Wind Speed Control -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="地表风速"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <SeekBar
                        android:id="@+id/sb_wind_speed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="150"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tv_wind_speed_val"
                        android:layout_width="74dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="0.0 m/s"
                        android:textColor="@color/accent_blue"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Meteo Wind Direction (0-360 degrees) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="气象风向"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <SeekBar
                        android:id="@+id/sb_wind_angle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="360"
                        android:progress="0" />

                    <TextView
                        android:id="@+id/tv_wind_angle_val"
                        android:layout_width="74dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:gravity="end"
                        android:text="000° (北风)"
                        android:textColor="@color/accent_blue"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Real-time Crosswind & Headwind Decomposition -->
                <TextView
                    android:id="@+id/tv_crosswind_breakdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="#0A1120"
                    android:fontFamily="monospace"
                    android:padding="6dp"
                    android:text="矢量分解: 纵向 0.0 m/s · 横向侧风 0.0 m/s"
                    android:textColor="@color/accent_amber"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Card 3: Target Inverse Solver (含侧风瞄准补偿) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="目标反推最佳发射参数 (含侧风补偿)"
                    android:textColor="@color/accent_amber"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="目标射程"
                        android:textColor="@color/text_secondary"
                        android:textSize="11.5sp" />

                    <EditText
                        android:id="@+id/et_target_dist"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_chip"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:hint="目标距离 (m)"
                        android:inputType="numberDecimal"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="100.0"
                        android:textColor="@color/accent_amber"
                        android:textColorHint="@color/text_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="m"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/rg_solve_mode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_solve_min_p"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="最小压力优先"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <RadioButton
                        android:id="@+id/rb_solve_fix_p"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="固定当前气压"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/btn_solve_target"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_accent"
                    android:text="开始反推最优发射配置"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Result Box -->
                <LinearLayout
                    android:id="@+id/box_solve_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#0A1120"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_solve_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:text="推荐方案..."
                        android:textColor="@color/text_primary"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_apply_solve"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:text="一键应用此参数并生成3D弹道"
                        android:textColor="@color/accent_blue"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Card 4: Structural & Advanced Physics Details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3D 空间动力学与碰撞参数"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_total_ground_dist"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="地面直线位移: 0.0 m"
                        android:textColor="@color/text_muted"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/tv_drift_angle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="侧偏航向角: 0.0°"
                        android:textColor="@color/text_muted"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_burn_water"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="喷水推力: 0.0 ms"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/tv_burn_air"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="monospace"
                        android:text="排气推力: 0.0 ms"
                        android:textColor="@color/text_secondary"
                        android:textSize="10.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_impact_energy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace"
                    android:text="落地速度: 0.0 m/s · 动能: 0.0 J"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
