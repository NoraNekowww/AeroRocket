<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Use Theme.AppCompat to prevent MaterialButton from overriding custom backgrounds and squashing button text -->
    <style name="Theme.WaterRocket" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryDark">#0284C7</item>
        <item name="colorAccent">@color/accent_blue</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>

        <!-- Disable MaterialButton automatic background tinting -->
        <item name="buttonStyle">@style/Widget.AppCompat.Button</item>
        <item name="android:buttonStyle">@style/Widget.AppCompat.Button</item>
    </style>
</resources>
